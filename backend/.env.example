VULTR_KEY=
PROXY_SECRET=
AUDIT_HMAC_KEY=
PORT=3000
HOST=127.0.0.1
MODEL=glm-5.3-flash

# Inspection time limits are OFF (unlimited). To bring one back, set it in milliseconds:
# NEORA_FETCH_MS=
# NEORA_DETONATE_MS=
# NEORA_BUDGET_MS=
# NEORA_RUN_MS=

# Windows executable runtime (Wine). Build the image once on the host: bash deploy/build-wine.sh
NEORA_WINE_IMAGE=neora-wine:1
# Observation window in seconds: the sample is run this long, then stopped. Reaching the end is normal (low note only).
NEORA_WINE_RUN_S=30
# Optional outer host watchdog for the whole container in ms (default: window + 90 s). Only a hung container hits it.
# NEORA_WINE_MS=
